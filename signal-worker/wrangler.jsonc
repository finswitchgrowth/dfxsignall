{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dfxsignall-signal-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-10-28",
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dfxsignall-signals",
      "database_id": "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID"
    }
  ],
  "vars": {
    "SIGNAL_MODE": "publish",
    "MIN_RISK_REWARD": "1.5",
    "MAX_CANDLE_AGE_MINUTES": "30"
  }
}
